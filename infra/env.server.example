# --- Infrastructure (internal only) ---
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
API_PORT=3001
WEB_PORT=3000

# --- Database ---
POSTGRES_DB=pine
POSTGRES_USER=pine
POSTGRES_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD_32_CHARS_MIN
DATABASE_URL=postgresql://pine:CHANGE_THIS_TO_STRONG_PASSWORD_32_CHARS_MIN@postgres:5432/pine?schema=public
REDIS_URL=redis://redis:6379

# --- Auth / API ---
JWT_SECRET=CHANGE_THIS_TO_LONG_RANDOM_STRING_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_THIS_TO_ANOTHER_LONG_RANDOM_STRING_MIN_32_CHARS
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
CLIENT_URL=https://pine.evergreen-explorers.online
ALLOWED_ORIGINS=https://pine.evergreen-explorers.online
APP_DEPLOYMENT_MODE=direct
PLAYBACK_OUTBOX_POLL_INTERVAL_MS=400
PLAYBACK_OUTBOX_BATCH_SIZE=100
PLAYBACK_OUTBOX_ADVISORY_LOCK_KEY=741337

# --- Media Delivery ---
# For self-hosted: start with API proxy mode (no public MinIO needed)
# Later you can enable direct media by setting MEDIA_DIRECT_URLS_ENABLED=1
# and exposing MinIO publicly (see SERVER_DEPLOY.md)
MEDIA_DIRECT_URLS_ENABLED=0
MEDIA_DIRECT_REQUIRED=0
MEDIA_DIRECT_URL_TTL_SEC=900

# --- MinIO ---
MINIO_ROOT_USER=pine
MINIO_ROOT_PASSWORD=CHANGE_THIS_TO_STRONG_MINIO_PASSWORD_32_CHARS
MINIO_ENDPOINT=minio:9000
# If you enable direct media later, set this to your public MinIO URL:
MINIO_PUBLIC_ENDPOINT=
MINIO_BUCKET_TRACKS=tracks
MINIO_BUCKET_COVERS=covers
MINIO_BUCKET_TRANSCODES=transcodes

# --- Worker tuning ---
PLAYBACK_COMMAND_POLLING_ENABLED=0
PLAYBACK_POLL_INTERVAL_MS=500
PLAYBACK_HEARTBEAT_INTERVAL_MS=30000
PLAYBACK_RECONCILE_INTERVAL_MS=5000
MEDIA_POLL_INTERVAL_MS=1500
MEDIA_HEARTBEAT_INTERVAL_MS=30000
MEDIA_MAX_BATCH_PER_TICK=5
MEDIA_ENABLE_TRANSCODE=1
FFMPEG_BIN=ffmpeg
FFMPEG_TRANSCODE_TIMEOUT_MS=600000

# --- Web ---
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_SOCKET_URL=
NEXT_PUBLIC_SITE_NAME=PINE
NEXT_PUBLIC_DIRECT_MEDIA_STRICT=1
BACKEND_PROXY_TARGET=http://api:3001
NEXT_PUBLIC_APP_DEPLOYMENT_MODE=direct
